# MarineOps Calendar environment configuration
# Copy to .env and fill values. Never commit .env to source control.

# ── Application ───────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=MarineOps
APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────
# DATABASE_URL is the RUNTIME (pooled) connection used by the running API.
# DIRECT_URL is the DIRECT connection used only by Prisma migrations/seed
# (poolers cannot run transactional DDL). On a plain local Postgres both
# may be identical; on Supabase DATABASE_URL points at the pooler and
# DIRECT_URL at the direct connection.
DATABASE_URL=postgresql://marineops:changeme@localhost:5432/marineops_dev
DIRECT_URL=postgresql://marineops:changeme@localhost:5432/marineops_dev

# ── Seed ──────────────────────────────────────
# Password for the seeded admin@marineops.local user (apps/api/prisma/seed.ts).
# Required outside development — the seed script refuses to run without it
# when NODE_ENV is not "development". Never commit a real value here.
SEED_ADMIN_PASSWORD=

# ── Auth (JWT) ───────────────────────────────
# Used by the Authentication module (ADR-0010). Generate strong random values.
JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret
JWT_REFRESH_SECRET=change-me-to-another-strong-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── Object storage (S3-compatible) ────────────
# NOT IMPLEMENTED. No application code reads any S3_* variable. It used
# to appear in the DEPLOYMENT.md topology, which has since been corrected
# to show only what exists. Setting these has no effect today; they are
# retained so the eventual implementation keeps the same names. Do not
# provision a bucket or credentials for this release.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=marineops-files
S3_USE_SSL=false

# ── Frontend ──────────────────────────────────
# The public web portal uses relative /api/public/* paths (proxied to the
# API in dev and via reverse proxy in production). No VITE_* API URL is
# consumed by the application.

# ── Observability ─────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ── Email (Phase 2+) ──────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@marineops.local

# ── OIDC (Phase 2+) ───────────────────────────
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ── MET Malaysia (Weather) ─────────────────────
# Server-side only. Never expose this key to frontend.
METMALAYSIA_API_KEY=

# ── JUPEM (Tide) ────────────────────────────────
# Server-side only. Never expose this key to frontend.
JUPEM_API_KEY=

# ── Cache / Redis (optional) ──────────────────
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ── Rate limiting ─────────────────────────────
# Reverse proxies that append to X-Forwarded-For before a request
# reaches the API. Express uses this to pick the real client out of that
# header, and both rate limiters key on the result.
#   1  web container (nginx) -> API                     [default]
#   2  TLS terminator -> web container (nginx) -> API
#   3  cloud LB -> TLS terminator -> nginx -> API
# Count proxies, not network devices. Too low and every client shares one
# rate-limit bucket; too high and a client can forge its own address past
# the limiter. A non-integer value is rejected at startup.
TRUSTED_PROXY_HOPS=1

RATE_LIMIT_MAX=100
# Dedicated, stricter limit for POST /api/v1/auth/login (per IP, per
# 15-minute window) — login has no other brute-force protection.
LOGIN_RATE_LIMIT_MAX=10