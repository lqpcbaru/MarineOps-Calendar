# MarineOps Calendar environment configuration
# Copy to .env and fill values. Never commit .env to source control.

# ── Application ───────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=MarineOps
APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────
DATABASE_URL=postgresql://marineops:changeme@localhost:5432/marineops_dev

# ── Auth (JWT) ───────────────────────────────
# Used by the Authentication module (ADR-0010). Generate strong random values.
JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret
JWT_REFRESH_SECRET=change-me-to-another-strong-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── Object storage (S3-compatible) ────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=marineops-files
S3_USE_SSL=false

# ── Frontend ──────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1

# ── Observability ─────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ── Email (Phase 2+) ──────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@marineops.local

# ── OIDC (Phase 2+) ───────────────────────────
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ── Global Fishing Watch (AIS) ────────────────
# Server-side only. Never expose this token to frontend.
GFW_API_TOKEN=