# Production environment configuration
#
# WARNING: This file is a TEMPLATE only. Do NOT commit real secrets.
# Production values must be supplied through the deployment secret
# manager / environment and never stored in the repository.
#
# Required variables (no default — the API fails to start if missing):
#   DATABASE_URL, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET

DATABASE_URL=
NODE_ENV=production
LOG_LEVEL=warn

# Application origin used for CORS (public web URL, e.g. https://app.example.com)
APP_URL=

# Server-side external provider credentials (never exposed to the browser)
GFW_API_TOKEN=
METMALAYSIA_API_KEY=

# JWT signing secrets — generate strong random values (see ADR-0010)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Optional
REDIS_URL=
REDIS_ENABLED=false
RATE_LIMIT_MAX=100
