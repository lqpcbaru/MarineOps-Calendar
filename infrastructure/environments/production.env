# Production environment configuration
#
# WARNING: This file is a TEMPLATE only. Do NOT commit real secrets.
# Production values must be supplied through the deployment secret
# manager / environment and never stored in the repository.
#
# Required variables (no default — the API fails to start if missing):
#   DATABASE_URL, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET

# Managed PostgreSQL. REQUIRE TLS: without sslmode the connection may
# negotiate plaintext, sending the password and every row across the
# network in the clear. Use verify-full where the provider publishes a CA
# certificate — it authenticates the server as well as encrypting, which
# `require` alone does not.
#   postgresql://user:pass@host:5432/marineops?sslmode=verify-full
#   postgresql://user:pass@host:5432/marineops?sslmode=require
DATABASE_URL=
NODE_ENV=production
PORT=3000
APP_NAME=MarineOps
LOG_LEVEL=warn
LOG_FORMAT=json

# Application origin used for CORS (public web URL, e.g. https://app.example.com)
APP_URL=

# Server-side external provider credentials (never exposed to the browser)
GFW_API_TOKEN=
METMALAYSIA_API_KEY=
JUPEM_API_KEY=

# JWT signing secrets — generate strong random values (see ADR-0010)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Optional
REDIS_URL=
REDIS_ENABLED=false
# Proxies that append to X-Forwarded-For. 1 = web container only;
# 2 = TLS terminator in front of it (docker-compose.tls.yml sets this).
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
