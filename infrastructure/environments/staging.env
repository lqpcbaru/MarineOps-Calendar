# Staging environment configuration
#
# WARNING: Template only. Staging secrets must be supplied through the
# deployment secret manager / environment, never committed to the repo.

DATABASE_URL=
# DIRECT_URL is the direct (non-pooled) connection used by Prisma
# migrations and the seed. See production.env for full explanation.
DIRECT_URL=
NODE_ENV=staging
PORT=3000
APP_NAME=MarineOps
LOG_LEVEL=info
LOG_FORMAT=json
APP_URL=

METMALAYSIA_API_KEY=
JUPEM_API_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Optional
REDIS_URL=
REDIS_ENABLED=false
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
