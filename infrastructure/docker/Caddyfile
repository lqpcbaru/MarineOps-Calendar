# TLS termination for MarineOps.
#
# Caddy's only job here is HTTPS: obtain and renew the certificate, then
# hand every request to the web container unchanged. All routing —
# public portal, /admin, /api, /health, SPA fallbacks, security headers —
# already lives in nginx.conf inside that container, and duplicating any
# of it here would create two places to keep in step.

{
	email {$ACME_EMAIL}
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	reverse_proxy web:8080 {
		# Caddy replaces X-Forwarded-For with the address it is actually
		# talking to, discarding whatever the client sent — verified by
		# proxying to an echo server: a request carrying a forged
		# `X-Forwarded-For: 9.9.9.9` arrived with Caddy's peer address
		# instead. nginx then appends Caddy, so the API sees two entries
		# and docker-compose.tls.yml sets TRUSTED_PROXY_HOPS=2 to match.
		# Caddy also sets X-Forwarded-Proto, which is what tells the API
		# the original request was HTTPS.
		header_up X-Real-IP {remote_host}
	}

	# Caddy already logs to stdout; keep it structured for the same
	# json-file driver the other services use.
	log {
		output stdout
		format json
	}
}
