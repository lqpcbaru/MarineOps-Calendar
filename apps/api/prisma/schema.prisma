generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Audit (owned by Audit module) ─────────────────────────────
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  userId    String?
  changes   Json?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_log")
}

// ── Users module models (minimal; owned by Users, read by Authentication) ──
// Per DOMAIN_MODEL §5.2. Authentication (Sprint 2) lands first and needs these
// tables to verify credentials. Full Users CRUD is a later sprint.

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  status        UserStatus     @default(ACTIVE)
  timezone      String         @default("UTC")
  locale        String         @default("en")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model Role {
  id            String         @id @default(uuid())
  name          String         @unique
  permissionCodes String[]     @map("permission_codes")
  users         UserRole[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ── Authentication module (owned by Authentication) ────────────
// Per ADR-0010 §4: refresh_token table stores HASH of refresh token.
// tokenHash is unique; familyId groups a rotation chain for reuse detection.

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_token")
}

// ── Stations module (owned by Stations) ─────────────────────────
// Per ADR-0012: single source of truth for operational locations.
// Soft-delete via status ARCHIVED. Region hierarchy is operational.

model OperationRegion {
  id             String            @id @default(uuid())
  code           String            @unique
  name           String
  description    String?
  parentRegionId String?           @map("parent_region_id")
  status         RegionStatus      @default(ACTIVE)
  sortOrder      Int               @default(0) @map("sort_order")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  parent   OperationRegion?  @relation("RegionHierarchy", fields: [parentRegionId], references: [id])
  children OperationRegion[] @relation("RegionHierarchy")
  stations Station[]

  @@index([parentRegionId])
  @@index([status])
  @@map("operation_regions")
}

enum RegionStatus {
  ACTIVE
  ARCHIVED
}

model Station {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  latitude  Decimal       @db.Decimal(9, 6)
  longitude Decimal       @db.Decimal(9, 6)
  timezone  String
  regionId  String?       @map("region_id")
  status    StationStatus @default(ACTIVE)
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  region            OperationRegion?            @relation(fields: [regionId], references: [id])
  providerMappings  StationProviderMapping[]

  @@index([regionId])
  @@index([status])
  @@map("stations")
}

enum StationStatus {
  ACTIVE
  ARCHIVED
}

model StationProviderMapping {
  id                String   @id @default(uuid())
  stationId         String   @map("station_id")
  dataType          String   @map("data_type")
  providerName      String   @map("provider_name")
  providerStationId String?  @map("provider_station_id")
  config            Json?
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, dataType])
  @@index([stationId, dataType])
  @@map("station_provider_mappings")
}
